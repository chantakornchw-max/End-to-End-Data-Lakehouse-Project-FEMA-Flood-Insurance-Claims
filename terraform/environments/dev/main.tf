# ==========================================
# Terraform & Provider Configuration
# ==========================================
terraform {
  required_version = ">= 1.10.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }

    databricks = {
      source  = "databricks/databricks"
      version = "~> 1.0"
    }
  }
}


# ==========================================
# Provider Configuration
# ==========================================
provider "aws" {
  region = var.aws_region
}

provider "databricks" {}


# ==========================================
# AWS Account Information
# ==========================================
data "aws_caller_identity" "current" {}

data "aws_partition" "current" {}


# ==========================================
# Local Values
# ==========================================
locals {
  name_prefix    = "fema-dev"
  s3_bucket_name = var.s3_bucket_name

  databricks_role_name = "${local.name_prefix}-databricks-s3-role"

  databricks_role_arn = "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:role/${local.databricks_role_name}"
}


# ==========================================
# VPC Module
# ==========================================
module "vpc" {
  source = "../../modules/vpc"

  name_prefix          = local.name_prefix
  vpc_cidr             = var.vpc_cidr
  public_subnet_1_cidr = var.public_subnet_1_cidr
  public_subnet_2_cidr = var.public_subnet_2_cidr
}


# ==========================================
# S3 Module
# ==========================================
module "s3" {
  source = "../../modules/s3"

  bucket_name   = local.s3_bucket_name
  force_destroy = var.force_destroy_s3
}


# ==========================================
# RDS Module
# ==========================================
module "rds" {
  source = "../../modules/rds"

  name_prefix = local.name_prefix

  vpc_id     = module.vpc.vpc_id
  subnet_ids = module.vpc.public_subnet_ids

  engine_version    = var.rds_engine_version
  instance_class    = var.rds_instance_class
  allocated_storage = var.rds_allocated_storage
  db_name           = var.rds_db_name

  username = var.rds_username
  password = var.rds_password

  ingress_cidr_blocks = var.rds_ingress_cidr_blocks

  publicly_accessible = var.rds_publicly_accessible
  skip_final_snapshot = var.rds_skip_final_snapshot
}


# ==========================================
# Databricks Storage Credential Module
# ==========================================
module "databricks_credential" {
  source = "../../modules/databricks_credential"

  credential_name = "${local.name_prefix}-s3-credential"

  # Precomputed ARN avoids a circular dependency with the IAM role.
  role_arn = local.databricks_role_arn
}


# ==========================================
# IAM Module
# ==========================================
module "iam" {
  source = "../../modules/iam"

  role_name   = local.databricks_role_name
  policy_name = "${local.name_prefix}-databricks-s3-policy"

  s3_bucket_name = local.s3_bucket_name

  # Use the External ID generated by Databricks.
  storage_credential_external_id = module.databricks_credential.external_id
}


# ==========================================
# Databricks Module
# ==========================================
module "databricks" {
  source = "../../modules/databricks"

  s3_bucket_name = local.s3_bucket_name

  storage_credential_name = module.databricks_credential.credential_name

  external_location_name = "${local.name_prefix}-s3-location"
  catalog_name           = "fema_dev"

  skip_validation = false

  rds_endpoint = module.rds.endpoint
  rds_username = var.rds_username
  rds_password = var.rds_password

  # Wait until S3 and IAM are ready before creating the external location.
  depends_on = [
    module.s3,
    module.iam
  ]
}