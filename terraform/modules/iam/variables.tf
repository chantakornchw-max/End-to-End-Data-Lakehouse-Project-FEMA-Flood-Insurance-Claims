# ==========================================
# IAM Resource Names
# ==========================================
variable "role_name" {
  description = "Name of the IAM role for Databricks Unity Catalog"
  type        = string
}

variable "policy_name" {
  description = "Name of the IAM policy for Databricks S3 access"
  type        = string
}


# ==========================================
# S3
# ==========================================
variable "s3_bucket_name" {
  description = "S3 bucket accessible by Unity Catalog"
  type        = string
}


# ==========================================
# Databricks Storage Credential
# ==========================================
variable "storage_credential_external_id" {
  description = "External ID generated by the Databricks storage credential"
  type        = string
  sensitive   = true
}